<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Eidet.Core\Eidet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Eidet.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>eidet</ToolCommandName>
    <PackageId>eidet</PackageId>
    <Version>0.4.1</Version>

    <!-- NuGet package metadata -->
    <Authors>Steve Hansen</Authors>
    <Description>Long-term memory for AI coding agents — local-first, privacy-absolute, works everywhere.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/stevehansen/eidet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stevehansen/eidet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;memory;coding-agent;mcp;eidetic</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\logo-512x512.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

</Project>
